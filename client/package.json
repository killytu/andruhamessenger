{
  "name": "andruha-messenger-client",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm run dev\" \"cross-env NODE_ENV=development electron electron/main.cjs\"",
    "electron:build": "npm run build && electron-builder",
    "electron:mac": "npm run build && electron-builder --mac",
    "electron:win": "npm run build && electron-builder --win",
    "electron:linux": "npm run build && electron-builder --linux",
    "electron:prod": "npm run build && electron electron/main.cjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "vite": "^5.0.0",
    "cross-env": "^7.0.3",
    "concurrently": "^8.2.2"
  },
  "build": {
    "appId": "com.andruha-messenger.app",
    "productName": "ANDRUHA MESSENGER",
    "copyright": "MIT",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    },
    "extraMetadata": {
      "main": "electron/main.cjs"
    }
  }
}